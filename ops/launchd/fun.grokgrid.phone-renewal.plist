<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>fun.grokgrid.phone-renewal</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__REPO__/scripts/phone-renew.mjs</string>
		<string>--config</string>
		<string>__HOME__/.config/grokgrid/runtime/phone-renewal-config.json</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/.config/grokgrid/runtime/logs/phone-renewal.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/.config/grokgrid/runtime/logs/phone-renewal.log</string>
	<key>StartInterval</key>
	<integer>1800</integer>
</dict>
</plist>
