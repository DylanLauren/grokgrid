# Public, read by the browser (VITE_ prefix). Addresses only, never keys.
VITE_MAIN_TICKER=GRID
VITE_MAIN_MINT=
VITE_BOT_WALLET=
VITE_BURN_WALLET=
VITE_X_HANDLE=
# Source link on the docs page. Defaults to https://github.com/DylComp/grokgrid
VITE_GITHUB_URL=
# Privy app and the GrokGrid agent signer + policy, all public ids (see docs/privy-agent-wallet.md).
VITE_PRIVY_APP_ID=
VITE_PRIVY_AGENT_SIGNER_ID=
VITE_PRIVY_AGENT_POLICY_ID=

# Server only.
# Bearer token Grok Bot sends to /api/ingest. Long random string. It can only write display data.
INGEST_TOKEN=
# Upstash Redis (or Vercel KV) REST credentials, for calls, stats and the agent registry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV names work too: KV_REST_API_URL / KV_REST_API_TOKEN.
# Public site address, used in coin metadata. Defaults to https://grokgrid-alpha.vercel.app
SITE_URL=
# Optional: faster, higher-limit RPC for balances and signature checks.
HELIUS_API_KEY=
# Used when HELIUS_API_KEY is unset. Defaults to a public RPC.
SOLANA_RPC_URL=
# Operator switch: launches open only with LAUNCHES_ENABLED=1 and the agent runner online.
LAUNCHES_ENABLED=
# Privy server checks for launches. The app secret is the only Privy secret Vercel holds;
# the signer's authorization key stays on the operator's machine.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AGENT_SIGNER_ID=
PRIVY_AGENT_POLICY_ID=
PRIVY_AGENT_POLICY_SHA256=
PRIVY_AGENT_POLICY_SUMMARY=

# WHEP playback URL of his phone's live stream, e.g. https://customer-<code>.cloudflarestream.com/<input uid>/webRTC/play
VITE_PHONE_STREAM=

# Server-only on-demand phone video. Never prefix these credentials with VITE_.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
