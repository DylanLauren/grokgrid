# Public, read by the browser (VITE_ prefix). Addresses only, never keys.
VITE_MAIN_TICKER=GRID
VITE_MAIN_MINT=
VITE_BOT_WALLET=
VITE_BURN_WALLET=
VITE_X_HANDLE=

# Server only.
# Bearer token Grok Bot sends to /api/ingest. Long random string. It can only write display data.
INGEST_TOKEN=
# Upstash Redis (or Vercel KV) REST credentials, for calls, stats and the agent registry.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Public site address, used in coin metadata. Defaults to https://grokgrid-alpha.vercel.app
SITE_URL=
# Optional: faster, higher-limit RPC for balances and signature checks.
HELIUS_API_KEY=

# WHEP playback URL of his phone's live stream, e.g. https://customer-<code>.cloudflarestream.com/<input uid>/webRTC/play
VITE_PHONE_STREAM=
